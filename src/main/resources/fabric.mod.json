{
  "schemaVersion": 1,
  "id": "cardcraft",
  "version": "${version}",
  "name": "CardCraft",
  "description": "Become the Ultimate Collector! Loot, trade, and fight in order to collect over 100 cards!",
  "authors": [
    "GamingEinstein"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/cardcraft",
    "sources": "https://github.com/GamingEinstein/CardCraft",
    "issues": "https://github.com/GamingEinstein/CardCraft/issues"
  },
  "license": "MIT",
  "icon": "cardcraft_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.gamingeinstein.cardcraft.CardCraft"
    ],
    "client": [
      "net.gamingeinstein.cardcraft.CardCraftClient"
    ],
    "fabric-datagen": [
      "net.gamingeinstein.cardcraft.CardCraftDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/kEkMdv232X"
      }
    }
  }
}
